<div class="timeline">
  {% for role in site.data.resume.work %}
    <div class="timeline-item stagger-reveal">
      <div class="timeline-marker"></div>
      <div class="timeline-card spotlight-card">
        <span class="timeline-date">
          {{- role.startDate | append: '-01' | date: '%b %Y' }} –
          {% if role.endDate %}{{ role.endDate | append: '-01' | date: '%b %Y' }}{% else %}Present{% endif -%}
        </span>
        <h3 class="timeline-title">{{ role.position }}</h3>
        <span class="timeline-org">{{ role.name }}</span>
        <p class="timeline-desc">{{ role.summary }}</p>
      </div>
    </div>
  {% endfor %}
</div>
