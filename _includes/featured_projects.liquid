<div class="featured-projects-grid">
  {% for project in site.data.resume.projects %}
    <div class="project-card spotlight-card stagger-reveal">
      <div class="project-icon" aria-hidden="true"><i class="{{ project.icon }}"></i></div>
      <h3 class="project-title">{{ project.name }}</h3>
      <p class="project-desc">{{ project.summary }}</p>
      <div class="project-tags">
        {% for keyword in project.keywords -%}
          <span class="fancy-badge badge-cyan">{{ keyword }}</span>
        {%- endfor %}
      </div>
      {% if project.url -%}
        <a class="project-source" href="{{ project.url }}">
          {{- project.linkLabel }}
          <span aria-hidden="true">↗</span></a
        >
      {%- endif %}
    </div>
  {% endfor %}
</div>
