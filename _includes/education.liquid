<div class="education-grid">
  {% for degree in site.data.resume.education %}
    <div class="education-card spotlight-card stagger-reveal">
      <div class="education-icon" aria-hidden="true"><i class="fa-solid fa-graduation-cap"></i></div>
      <div class="education-content">
        <h3 class="education-degree">{{ degree.studyType }} · {{ degree.area }}</h3>
        <span class="education-school">{{ degree.institution }}</span>
        <span class="education-gpa">
          {{- degree.startDate | append: '-01' | date: '%b %Y' }} – {{ degree.endDate | append: '-01' | date: '%b %Y' -}}
        </span>
        {% if degree.score %}
          <p class="education-highlights">GPA: {{ degree.score }}</p>
        {% endif %}
        <p class="education-highlights">{{ degree.courses | join: ' · ' }}</p>
      </div>
    </div>
  {% endfor %}
</div>
