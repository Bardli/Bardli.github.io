---
layout: default
---
<div class="post">
  <!-- Hero Section -->
  <div class="fancy-hero">
    <canvas id="particle-canvas"></canvas>
    <div class="hero-content">
      {% if page.profile and page.profile.image %}
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        <img
          src="{{ profile_image_path | relative_url }}"
          alt="{{ site.first_name }} {{ site.last_name }} - Profile Photo"
          class="hero-avatar"
          loading="eager"
        >
      {% endif %}

      <h1 class="hero-name" id="hero-name">
        {% if site.title == 'blank' %}
          {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>

      {% if page.subtitle %}
        <p class="hero-subtitle shiny-text">{{ page.subtitle }}</p>
      {% endif %}

      <div class="typing-container">
        <span class="typing-text" id="typing-text"></span>
        <span class="typing-cursor"></span>
      </div>
    </div>
  </div>

  <article>
    <!-- About / Bio -->
    {% if content != blank %}
      <div class="fancy-section scroll-reveal">
        <h2 class="fancy-section-heading">About</h2>
        <div class="fancy-bio-card glare-card spotlight-card">
          {{ content }}
        </div>
      </div>
    {% endif %}

    <!-- Impact Stats -->
    {% if page.impact_stats and page.impact_stats.enabled %}
      <div class="fancy-section scroll-reveal">
        <h2 class="fancy-section-heading">Impact</h2>
        {% include impact_stats.liquid %}
      </div>
    {% endif %}

    <!-- Journey Timeline -->
    {% if page.timeline and page.timeline.enabled %}
      <div class="fancy-section scroll-reveal">
        <h2 class="fancy-section-heading">Journey</h2>
        {% include timeline.liquid %}
      </div>
    {% endif %}

    <!-- Featured Work -->
    {% if page.featured_projects and page.featured_projects.enabled %}
      <div class="fancy-section scroll-reveal">
        <h2 class="fancy-section-heading">Featured Work</h2>
        {% include featured_projects.liquid %}
      </div>
    {% endif %}

    <!-- Education -->
    {% if page.education and page.education.enabled %}
      <div class="fancy-section scroll-reveal">
        <h2 class="fancy-section-heading">Education</h2>
        {% include education.liquid %}
      </div>
    {% endif %}

    <!-- Skills -->
    {% if page.skills and page.skills.enabled %}
      <div class="fancy-section scroll-reveal">
        <h2 class="fancy-section-heading">Skills</h2>
        {% include skills.liquid %}
      </div>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <div class="fancy-section scroll-reveal">
        <h2 class="fancy-section-heading">
          <a href="{{ '/news/' | relative_url }}">News</a>
        </h2>
        {% include news.liquid limit=true %}
      </div>
    {% endif %}

    <!-- Latest Posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <div class="fancy-section scroll-reveal">
        <h2 class="fancy-section-heading">
          <a href="{{ '/blog/' | relative_url }}">Latest Posts</a>
        </h2>
        {% include latest_posts.liquid %}
      </div>
    {% endif %}

    <!-- Selected Publications -->
    {% if page.selected_papers %}
      <div class="fancy-section scroll-reveal">
        <h2 class="fancy-section-heading">
          <a href="{{ '/publications/' | relative_url }}">Selected Publications</a>
        </h2>
        {% include selected_papers.liquid %}
      </div>
    {% endif %}

    <!-- Contact / Social -->
    {% if page.social %}
      <div class="fancy-section scroll-reveal fancy-contact">
        <h2 class="fancy-section-heading">Contact</h2>
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
  <canvas id="click-spark-canvas"></canvas>
</div>
